    default_action: themis250
  counter tbl_themis250$stats.Ingress.ingress_port_debug_counter:
    p4: { name: Ingress.ingress_port_debug_counter, size: 512 }
    row: 5
    logical_bus: S
    column: [ 0, 1 ]
    maprams: [ 0, 1 ]
    vpns: [ 0, 1 ]
