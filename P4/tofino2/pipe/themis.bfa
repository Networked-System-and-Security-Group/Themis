stage 1 ingress:
  dependency: action
  mpr_stage_id: 0
  mpr_bus_dep_glob_exec: 0x0
  mpr_bus_dep_long_brch: 0x0
  mpr_always_run: 0x3
  ternary_match tbl_themis269 0:
    p4: { name: tbl_themis269, hidden: true }
    gateway:
      name: cond-17
      input_xbar:
        exact group 0: { 0: hdr.recir.cnt }
      row: 1
      bus: 1
      unit: 1
      match: { 0: hdr.recir.cnt(0..7), 8: hdr.recir.cnt(8..15), 16: hdr.recir.cnt(16..23), 24: hdr.recir.cnt(24..31) }
      0x00000000: run_table
      miss:  tbl_themis276
      condition: 
        expression: "(hdr.recir.cnt == 0)"
        true:  tbl_themis269
        false:  tbl_themis276
    hit: [  END ]
    miss:  END
    indirect: tbl_themis269$tind
  ternary_indirect tbl_themis269$tind:
    row: 2
    bus: 0
    format: { action: 0..0 }
    instruction: tbl_themis269$tind(action, $DEFAULT)
    actions:
      themis269(1, 1):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000006
      - next_table: 0
      - set apply_l3_0, 1
      - set hdr.recir.$valid, 0
    default_action: themis269
  ternary_match tbl_themis276 1:
    p4: { name: tbl_themis276, hidden: true }
    hit: [  END ]
    miss:  END
    indirect: tbl_themis276$tind
  ternary_indirect tbl_themis276$tind:
    row: 1
    bus: 1
    format: { action: 0..0 }
    instruction: tbl_themis276$tind(action, $DEFAULT)
    actions:
      themis276(0, 2):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000007
      - next_table: 0
      - add hdr.recir.cnt, hdr.recir.cnt, 4294967295
      - set ig_intr_md_for_tm.bypass_egress, 1
      - set H0(0..1), 3
      - set H1(0..8), 384
    default_action: themis276
stage 2 ingress:
  dependency: match
  mpr_stage_id: 2
  mpr_bus_dep_glob_exec: 0x0
  mpr_bus_dep_long_brch: 0x0
  mpr_always_run: 0x6
  gateway cond-19 1:
    always_run: true
    name: cond-19
    input_xbar:
      exact group 0: { 3: hdr.recir.$valid, 7: hdr.udp.$valid, 8: hdr.bth.$valid, 16: ig_intr_md.ingress_port }
    row: 0
    bus: 0
    unit: 0
    match: { 19: hdr.recir.$valid, 0: ig_intr_md.ingress_port(0..7), 8: ig_intr_md.ingress_port(8), 23: hdr.udp.$valid, 24: hdr.bth.$valid }
    0b************1*******************:  END
    0b***********************110000000:  END
    0b********0***********************:  END
    0b*******0************************:  END
    miss:  tbl_start_one_recir
    condition: 
      expression: "(!(hdr.recir.$valid == 1) && ig_intr_md.ingress_port != 384 && hdr.udp.$valid == 1 && hdr.bth.$valid == 1 && hdr.udp.dst_port == 4791 && hdr.bth.opcode != 129 && hdr.bth.psn[0:0] == 0)"
      true:  tbl_start_one_recir
      false:  END
  ternary_match tbl_start_one_recir 2:
    p4: { name: tbl_start_one_recir, hidden: true }
    gateway:
      name: cond-19$split
      input_xbar:
        exact group 0: { 32: hdr.bth.psn.0-15(0), 40: hdr.udp.dst_port(8..15), 48: hdr.udp.dst_port(0..7), 56: hdr.bth.opcode }
      row: 0
      bus: 1
      unit: 1
      match: { 16: hdr.bth.opcode, 24: hdr.bth.psn.0-15(0), 0: hdr.udp.dst_port(0..7), 8: hdr.udp.dst_port(8..15) }
      0x**81****:  END
      0b*******1************************:  END
      0x****12b7: run_table
      miss:  END
      condition: 
        expression: "(!(hdr.recir.$valid == 1) && ig_intr_md.ingress_port != 384 && hdr.udp.$valid == 1 && hdr.bth.$valid == 1 && hdr.udp.dst_port == 4791 && hdr.bth.opcode != 129 && hdr.bth.psn[0:0] == 0)"
        true:  tbl_start_one_recir
        false:  END
    hit: [  END ]
    miss:  END
    indirect: tbl_start_one_recir$tind
  counter tbl_start_one_recir$stats.Ingress.recir_debug_counter:
    p4: { name: Ingress.recir_debug_counter, size: 1 }
    row: 13
    logical_bus: S
    column: [ 0, 1 ]
    maprams: [ 0, 1 ]
    vpns: [ 0, 1 ]
    home_row: 13
    count: packets
    format: {packets(0): 96..127, packets(1): 64..95, packets(2): 32..63, packets(3): 0..31}
    per_flow_enable: counter_pfe
    lrt:
    - { threshold: 23718048, interval: 379488768 }
    - { threshold: 23718048, interval: 379488768 }
    - { threshold: 23718048, interval: 379488768 }
  ternary_indirect tbl_start_one_recir$tind:
