    - { name : hdr.ipv4.frag_offset, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.ipv4.ttl, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.ipv4.protocol, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
parser ingress:
  start: $entry_point
  bitwise_or: [ MB0, MB1, H0 ]
  hdr_len_adj: 32
  states:
    $entry_point:
      *:
        load: { byte0 : 0 }
        buf_req: 1
        next: start
    start:
      match: [ byte0 ]
      0b1*******:
        0..1: H9  # bit[7..15] -> H9 bit[8..0]: ingress::ig_intr_md.ingress_port
        B4: 6  # value 6 -> B4 bit[7..0]: ingress::meta.pkt_type
        shift: 8
        buf_req: 8
        next: end
      0b0*******:
        0..1: H9  # bit[7..15] -> H9 bit[8..0]: ingress::ig_intr_md.ingress_port
        B4: 6  # value 6 -> B4 bit[7..0]: ingress::meta.pkt_type
        load: { byte0 : 0, byte1 : 1 }
        shift: 8
        buf_req: 8
        next: TofinoIngressParser_parse_port_metadata
    TofinoIngressParser_parse_port_metadata:
      match: [ byte0, byte1 ]
      0b*******110000000:
        shift: 24
        buf_req: 24
        next: parse_recir
      0x****:
        shift: 24
        buf_req: 24
        next: TofinoIngressParser_parse_port_metadata.$oob_stall_0
    parse_recir:
      *:
        0..3: W0  # ingress::hdr.recir.cnt
        H0: 8  # value 1 -> H0 bit[3]: ingress::hdr.recir.$valid
        load: { byte0 : 16, byte1 : 17 }
        shift: 4
        buf_req: 18
        next: parse_ethernet
    parse_ethernet:
      match: [ byte0, byte1 ]
      0x0800:
        12..13: MH6  # ingress::hdr.ethernet.ether_type
        H0: 16  # value 1 -> H0 bit[4]: ingress::hdr.ethernet.$valid
        clot 3 :
          start: 0
          length: 14
        load: { byte0 : 23 }
        shift: 14
        buf_req: 24
        next: parse_ipv4
      0x0806:
        12..13: MH6  # ingress::hdr.ethernet.ether_type
        H0: 16  # value 1 -> H0 bit[4]: ingress::hdr.ethernet.$valid
        clot 3 :
          start: 0
          length: 14
        shift: 14
        buf_req: 14
        next: parse_arp
      0x****:
        12..13: MH6  # ingress::hdr.ethernet.ether_type
        H0: 16  # value 1 -> H0 bit[4]: ingress::hdr.ethernet.$valid
        clot 3 :
          start: 0
          length: 14
        shift: 14
        buf_req: 14
        next: end
    parse_ipv4:
      match: [ byte0 ]
      0x06:
        16..19: MW2  # ingress::hdr.ipv4.dst_addr
        H0: 32  # value 1 -> H0 bit[5]: ingress::hdr.ipv4.$valid
        clot 2 :
          start: 0
          length: 20
        shift: 20
        buf_req: 20
        next: parse_tcp
      0x11:
        16..19: MW2  # ingress::hdr.ipv4.dst_addr
        H0: 32  # value 1 -> H0 bit[5]: ingress::hdr.ipv4.$valid
        clot 2 :
          start: 0
          length: 20
        load: { byte0 : 22, byte1 : 23 }
        shift: 20
        buf_req: 24
        next: parse_udp
      0x**:
        16..19: MW2  # ingress::hdr.ipv4.dst_addr
        H0: 32  # value 1 -> H0 bit[5]: ingress::hdr.ipv4.$valid
        clot 2 :
          start: 0
          length: 20
        shift: 20
        buf_req: 20
        next: end
    parse_tcp:
      *:
        H0: 64  # value 1 -> H0 bit[6]: ingress::hdr.tcp.$valid
        clot 0 :
          start: 0
          length: 32
        shift: 32
        buf_req: 32
        next: end
    parse_udp:
      match: [ byte0, byte1 ]
      0x12b7:
        2..3: MH5  # ingress::hdr.udp.dst_port
        H0: 128  # value 1 -> H0 bit[7]: ingress::hdr.udp.$valid
        clot 5 :
          start: 0
          length: 8
        shift: 8
        buf_req: 8
        next: parse_bth
      0x****:
        2..3: MH5  # ingress::hdr.udp.dst_port
        H0: 128  # value 1 -> H0 bit[7]: ingress::hdr.udp.$valid
        clot 5 :
          start: 0
          length: 8
        shift: 8
        buf_req: 8
        next: end
    parse_bth:
      *:
        0: MB0  # ingress::hdr.bth.opcode
        9: MB1  # ingress::hdr.bth.psn[23:16].16-23
        10..11: MH4  # ingress::hdr.bth.psn[15:0].0-15
        H0: 256  # value 1 -> H0 bit[8]: ingress::hdr.bth.$valid
        clot 4 :
          start: 0
          length: 12
        shift: 12
        buf_req: 12
        next: end
    parse_arp:
      *:
        24..27: MW2  # ingress::hdr.arp.dstIpv4Addr
        H0: 512  # value 1 -> H0 bit[9]: ingress::hdr.arp.$valid
        clot 1 :
          start: 0
          length: 28
        shift: 28
        buf_req: 28
        next: end
    TofinoIngressParser_parse_port_metadata.$oob_stall_0:
      *:
        load: { byte0 : 12, byte1 : 13 }
        buf_req: 14
        next: parse_ethernet
deparser ingress:
  dictionary:
    B3: H0(10)  # ingress::hdr.bridged_md.pkt_type if ingress::hdr.bridged_md.$valid
    W0: H0(3)  # ingress::hdr.recir.cnt if ingress::hdr.recir.$valid
    clot 3:
      pov: hdr.ethernet.$valid
    clot 2:
      pov: hdr.ipv4.$valid
    clot 1:
      pov: hdr.arp.$valid
    clot 0:
      pov: hdr.tcp.$valid
    clot 5:
      pov: hdr.udp.$valid
    clot 4:
      pov: hdr.bth.$valid
  egress_unicast_port: { H1(0..8): H0(0) }  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port if ingress::ig_intr_md_for_tm.ucast_egress_port.$valid
  bypss_egr: { B2(0..0): H0(1) }  # bit[0]: ingress::ig_intr_md_for_tm.bypass_egress if ingress::ig_intr_md_for_tm.bypass_egress.$valid
  mirror:
    select: { B0(0..3): H0(2) }  # bit[3..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    1:
      - B1  # ingress::meta.ing_mir_ses
      - B4  # ingress::meta.pkt_type
parser egress:
  start: $entry_point
  bitwise_or: [ MH2, H4 ]
  hdr_len_adj: 28
  meta_opt: 8191
  states:
    $entry_point:
      *:
        load: { byte0 : 28 }
        buf_req: 29
        next: start
    start:
      match: [ byte0 ]
      0x09:
        0..1: MH1  # bit[7..15] -> MH1 bit[8..0]: egress::eg_intr_md.egress_port
        MH2: 1  # value 1 -> MH2 bit[0]: egress::eg_intr_md_for_dprsr.mirror_io_select
        H4: 3
            # - value 1 -> H4 bit[0]: egress::eg_intr_md_for_dprsr.mirror_io_select.$valid
            # - value 1 -> H4 bit[1]: egress::eg_intr_md.egress_port.$valid
        intr_md: 9
        shift: 28
        buf_req: 28
        next: parse_mirror_md
      0x06:
        0..1: MH1  # bit[7..15] -> MH1 bit[8..0]: egress::eg_intr_md.egress_port
        MH2: 1  # value 1 -> MH2 bit[0]: egress::eg_intr_md_for_dprsr.mirror_io_select
        H4: 3
            # - value 1 -> H4 bit[0]: egress::eg_intr_md_for_dprsr.mirror_io_select.$valid
            # - value 1 -> H4 bit[1]: egress::eg_intr_md.egress_port.$valid
        intr_md: 9
        shift: 28
        buf_req: 28
        next: parse_bridged_md
      0x**:
        0..1: MH1  # bit[7..15] -> MH1 bit[8..0]: egress::eg_intr_md.egress_port
        MH2: 1  # value 1 -> MH2 bit[0]: egress::eg_intr_md_for_dprsr.mirror_io_select
        H4: 3
            # - value 1 -> H4 bit[0]: egress::eg_intr_md_for_dprsr.mirror_io_select.$valid
            # - value 1 -> H4 bit[1]: egress::eg_intr_md.egress_port.$valid
        intr_md: 9
        shift: 28
        buf_req: 28
        next: end
    parse_mirror_md:
      *:
        MH2: 2  # value 1 -> MH2 bit[1]: egress::meta.is_mirrored
        load: { byte0 : 13, byte1 : 14 }
        shift: 1
        buf_req: 15
        next: parse_ethernet
    parse_ethernet:
      match: [ byte0, byte1 ]
      0x0800:
        0..1: MH9  # egress::hdr.ethernet.dst_addr[47:32].32-47
        2..5: MW1  # egress::hdr.ethernet.dst_addr[31:0].0-31
        6..7: MH8  # egress::hdr.ethernet.src_addr[47:32].32-47
        8..11: MW0  # egress::hdr.ethernet.src_addr[31:0].0-31
        H4: 4  # value 1 -> H4 bit[2]: egress::hdr.ethernet.$valid
        clot 2 :
          start: 12
          length: 2
        load: { byte0 : 23 }
        shift: 14
        buf_req: 24
        next: parse_ipv4
      0x0806:
        0..1: MH9  # egress::hdr.ethernet.dst_addr[47:32].32-47
        2..5: MW1  # egress::hdr.ethernet.dst_addr[31:0].0-31
        6..7: MH8  # egress::hdr.ethernet.src_addr[47:32].32-47
        8..11: MW0  # egress::hdr.ethernet.src_addr[31:0].0-31
        H4: 4  # value 1 -> H4 bit[2]: egress::hdr.ethernet.$valid
        clot 2 :
          start: 12
          length: 2
        shift: 14
        buf_req: 14
        next: parse_arp
      0x****:
        0..1: MH9  # egress::hdr.ethernet.dst_addr[47:32].32-47
        2..5: MW1  # egress::hdr.ethernet.dst_addr[31:0].0-31
        6..7: MH8  # egress::hdr.ethernet.src_addr[47:32].32-47
        8..11: MW0  # egress::hdr.ethernet.src_addr[31:0].0-31
        H4: 4  # value 1 -> H4 bit[2]: egress::hdr.ethernet.$valid
        clot 2 :
          start: 12
          length: 2
        shift: 14
        buf_req: 14
        next: end
    parse_ipv4:
      match: [ byte0 ]
      0x06:
        0..1: H7
            # - bit[0..3] -> H7 bit[15..12]: egress::hdr.ipv4.version
            # - bit[4..7] -> H7 bit[11..8]: egress::hdr.ipv4.ihl
            # - bit[8..13] -> H7 bit[7..2]: egress::hdr.ipv4.diffserv
            # - bit[14..15] -> H7 bit[1..0]: egress::hdr.ipv4.ecn
        2..5: W6
            # - bit[16..31] -> W6 bit[31..16]: egress::hdr.ipv4.total_len
            # - bit[32..47] -> W6 bit[15..0]: egress::hdr.ipv4.identification
        6..9: W13
            # - bit[48..50] -> W13 bit[31..29]: egress::hdr.ipv4.flags
            # - bit[51..63] -> W13 bit[28..16]: egress::hdr.ipv4.frag_offset
            # - bit[64..71] -> W13 bit[15..8]: egress::hdr.ipv4.ttl
            # - bit[72..79] -> W13 bit[7..0]: egress::hdr.ipv4.protocol
        10..11: MH10  # egress::hdr.ipv4.hdr_checksum
        12..15: W12  # egress::hdr.ipv4.src_addr
        16..19: MW4  # egress::hdr.ipv4.dst_addr
        H4: 8  # value 1 -> H4 bit[3]: egress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: parse_tcp
      0x11:
        0..1: H7
            # - bit[0..3] -> H7 bit[15..12]: egress::hdr.ipv4.version
            # - bit[4..7] -> H7 bit[11..8]: egress::hdr.ipv4.ihl
            # - bit[8..13] -> H7 bit[7..2]: egress::hdr.ipv4.diffserv
            # - bit[14..15] -> H7 bit[1..0]: egress::hdr.ipv4.ecn
        2..5: W6
            # - bit[16..31] -> W6 bit[31..16]: egress::hdr.ipv4.total_len
            # - bit[32..47] -> W6 bit[15..0]: egress::hdr.ipv4.identification
        6..9: W13
            # - bit[48..50] -> W13 bit[31..29]: egress::hdr.ipv4.flags
            # - bit[51..63] -> W13 bit[28..16]: egress::hdr.ipv4.frag_offset
            # - bit[64..71] -> W13 bit[15..8]: egress::hdr.ipv4.ttl
            # - bit[72..79] -> W13 bit[7..0]: egress::hdr.ipv4.protocol
        10..11: MH10  # egress::hdr.ipv4.hdr_checksum
        12..15: W12  # egress::hdr.ipv4.src_addr
        16..19: MW4  # egress::hdr.ipv4.dst_addr
        H4: 8  # value 1 -> H4 bit[3]: egress::hdr.ipv4.$valid
        load: { byte0 : 22, byte1 : 23 }
        shift: 20
        buf_req: 24
        next: parse_udp
      0x**:
        0..1: H7
            # - bit[0..3] -> H7 bit[15..12]: egress::hdr.ipv4.version
            # - bit[4..7] -> H7 bit[11..8]: egress::hdr.ipv4.ihl
            # - bit[8..13] -> H7 bit[7..2]: egress::hdr.ipv4.diffserv
            # - bit[14..15] -> H7 bit[1..0]: egress::hdr.ipv4.ecn
        2..5: W6
            # - bit[16..31] -> W6 bit[31..16]: egress::hdr.ipv4.total_len
            # - bit[32..47] -> W6 bit[15..0]: egress::hdr.ipv4.identification
        6..9: W13
            # - bit[48..50] -> W13 bit[31..29]: egress::hdr.ipv4.flags
            # - bit[51..63] -> W13 bit[28..16]: egress::hdr.ipv4.frag_offset
            # - bit[64..71] -> W13 bit[15..8]: egress::hdr.ipv4.ttl
            # - bit[72..79] -> W13 bit[7..0]: egress::hdr.ipv4.protocol
        10..11: MH10  # egress::hdr.ipv4.hdr_checksum
        12..15: W12  # egress::hdr.ipv4.src_addr
        16..19: MW4  # egress::hdr.ipv4.dst_addr
        H4: 8  # value 1 -> H4 bit[3]: egress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: end
    parse_tcp:
      *:
        H4: 16  # value 1 -> H4 bit[4]: egress::hdr.tcp.$valid
        clot 0 :
          start: 0
          length: 32
        shift: 32
        buf_req: 32
        next: end
    parse_udp:
      match: [ byte0, byte1 ]
      0x12b7:
        checksum 0:
          type: RESIDUAL
          mask: [ 0..1, 2..3, 6..7 ]
          swap: 0
          start: 1
          end: 1
          dest: MH0
          end_pos: 7
        checksum 2:
          type: CLOT
          mask: [ 0..1 ]
          swap: 0
          start: 1
          end: 1
          dest: clot 4
        0..1: MH3  # egress::hdr.udp.src_port
        2..5: W5
            # - bit[16..31] -> W5 bit[31..16]: egress::hdr.udp.dst_port
            # - bit[32..47] -> W5 bit[15..0]: egress::hdr.udp.hdr_length
        6..7: H8  # egress::hdr.udp.checksum
        H4: 32  # value 1 -> H4 bit[5]: egress::hdr.udp.$valid
        clot 4 :
          start: 0
          length: 2
          checksum:  2
        shift: 8
        buf_req: 8
        next: parse_bth
      0x****:
        checksum 0:
          type: RESIDUAL
          mask: [ 0..1, 2..3, 6..7 ]
          swap: 0
          start: 1
          end: 1
          dest: MH0
          end_pos: 7
        checksum 2:
          type: CLOT
          mask: [ 0..1 ]
          swap: 0
          start: 1
          end: 1
          dest: clot 4
        0..1: MH3  # egress::hdr.udp.src_port
        2..5: W5
            # - bit[16..31] -> W5 bit[31..16]: egress::hdr.udp.dst_port
            # - bit[32..47] -> W5 bit[15..0]: egress::hdr.udp.hdr_length
        6..7: H8  # egress::hdr.udp.checksum
        H4: 32  # value 1 -> H4 bit[5]: egress::hdr.udp.$valid
        clot 4 :
          start: 0
          length: 2
          checksum:  2
        shift: 8
        buf_req: 8
        next: end
    parse_bth:
      *:
        0..3: W3
            # - bit[0..7] -> W3 bit[31..24]: egress::hdr.bth.opcode
            # - bit[8] -> W3 bit[23]: egress::hdr.bth.solicited_event
            # - bit[9] -> W3 bit[22]: egress::hdr.bth.mig_req
            # - bit[10..11] -> W3 bit[21..20]: egress::hdr.bth.pad_count
            # - bit[12..15] -> W3 bit[19..16]: egress::hdr.bth.header_v
            # - bit[16..31] -> W3 bit[15..0]: egress::hdr.bth.parti_key
        4..5: H5
            # - bit[32..39] -> H5 bit[15..8]: egress::hdr.bth.reserved1
            # - bit[40..47] -> H5 bit[7..0]: egress::hdr.bth.dst_qpn[23:16].16-23
        6..7: H6  # egress::hdr.bth.dst_qpn[15:0].0-15
        8..11: W4
            # - bit[64] -> W4 bit[31]: egress::hdr.bth.ack_req
            # - bit[65..71] -> W4 bit[30..24]: egress::hdr.bth.reserved2
            # - bit[72..95] -> W4 bit[23..0]: egress::hdr.bth.psn
        H4: 64  # value 1 -> H4 bit[6]: egress::hdr.bth.$valid
        shift: 12
        buf_req: 12
        next: end
    parse_arp:
      *:
        H4: 128  # value 1 -> H4 bit[7]: egress::hdr.arp.$valid
        clot 1 :
          start: 0
          length: 28
        shift: 28
        buf_req: 28
        next: end
    parse_bridged_md:
      *:
        load: { byte0 : 13, byte1 : 14 }
        shift: 1
        buf_req: 15
        next: parse_ethernet
deparser egress:
  dictionary:
    MH9: H4(2)  # egress::hdr.ethernet.dst_addr.32-47 if egress::hdr.ethernet.$valid
    MW1: H4(2)  # egress::hdr.ethernet.dst_addr.0-31 if egress::hdr.ethernet.$valid
    MH8: H4(2)  # egress::hdr.ethernet.src_addr.32-47 if egress::hdr.ethernet.$valid
    MW0: H4(2)  # egress::hdr.ethernet.src_addr.0-31 if egress::hdr.ethernet.$valid
    clot 2:
      pov: hdr.ethernet.$valid
    H7: H4(3)
        # - bit[15..12]: egress::hdr.ipv4.version if egress::hdr.ipv4.$valid
        # - bit[11..8]: egress::hdr.ipv4.ihl if egress::hdr.ipv4.$valid
        # - bit[7..2]: egress::hdr.ipv4.diffserv if egress::hdr.ipv4.$valid
        # - bit[1..0]: egress::hdr.ipv4.ecn if egress::hdr.ipv4.$valid
    W6: H4(3)
        # - bit[31..16]: egress::hdr.ipv4.total_len if egress::hdr.ipv4.$valid
        # - bit[15..0]: egress::hdr.ipv4.identification if egress::hdr.ipv4.$valid
    W13: H4(3)
        # - bit[31..29]: egress::hdr.ipv4.flags if egress::hdr.ipv4.$valid
        # - bit[28..16]: egress::hdr.ipv4.frag_offset if egress::hdr.ipv4.$valid
        # - bit[15..8]: egress::hdr.ipv4.ttl if egress::hdr.ipv4.$valid
        # - bit[7..0]: egress::hdr.ipv4.protocol if egress::hdr.ipv4.$valid
    full_checksum 4: H4(3)  # egress::hdr.ipv4.$valid
    W12: H4(3)  # egress::hdr.ipv4.src_addr if egress::hdr.ipv4.$valid
    MW4: H4(3)  # egress::hdr.ipv4.dst_addr if egress::hdr.ipv4.$valid
    clot 1:
      pov: hdr.arp.$valid
    clot 0:
      pov: hdr.tcp.$valid
    clot 4:
      pov: hdr.udp.$valid
    W5: H4(5)
        # - bit[31..16]: egress::hdr.udp.dst_port if egress::hdr.udp.$valid
        # - bit[15..0]: egress::hdr.udp.hdr_length if egress::hdr.udp.$valid
    full_checksum 5: B17(1)  # egress::hdr.udp.checksum.$deparse_updated_csum_0
    H8: B17(0)  # egress::hdr.udp.checksum if egress::hdr.udp.checksum.$deparse_original_csum
    W3: H4(6)
        # - bit[31..24]: egress::hdr.bth.opcode if egress::hdr.bth.$valid
        # - bit[23]: egress::hdr.bth.solicited_event if egress::hdr.bth.$valid
        # - bit[22]: egress::hdr.bth.mig_req if egress::hdr.bth.$valid
        # - bit[21..20]: egress::hdr.bth.pad_count if egress::hdr.bth.$valid
        # - bit[19..16]: egress::hdr.bth.header_v if egress::hdr.bth.$valid
        # - bit[15..0]: egress::hdr.bth.parti_key if egress::hdr.bth.$valid
    H5: H4(6)
        # - bit[15..8]: egress::hdr.bth.reserved1 if egress::hdr.bth.$valid
        # - bit[7..0]: egress::hdr.bth.dst_qpn.16-23 if egress::hdr.bth.$valid
    H6: H4(6)  # egress::hdr.bth.dst_qpn.0-15 if egress::hdr.bth.$valid
    W4: H4(6)
        # - bit[31]: egress::hdr.bth.ack_req if egress::hdr.bth.$valid
        # - bit[30..24]: egress::hdr.bth.reserved2 if egress::hdr.bth.$valid
        # - bit[23..0]: egress::hdr.bth.psn if egress::hdr.bth.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved1.56-63 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved1.48-55 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved1.40-47 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved1.32-39 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved1.24-31 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved1.16-23 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved1.8-15 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved1.0-7 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved2.56-63 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved2.48-55 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved2.40-47 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved2.32-39 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved2.24-31 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved2.16-23 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved2.8-15 if egress::hdr.cnp_padding.$valid
    B16: H4(8)  # egress::hdr.cnp_padding.reserved2.0-7 if egress::hdr.cnp_padding.$valid
    W2: H4(9)  # egress::hdr.icrc.value if egress::hdr.icrc.$valid
  partial_checksum 4: 
    - H7: { pov: H4(3) }
        # - bit[15..12]: egress::hdr.ipv4.version if egress::hdr.ipv4.$valid
        # - bit[11..8]: egress::hdr.ipv4.ihl if egress::hdr.ipv4.$valid
        # - bit[7..2]: egress::hdr.ipv4.diffserv if egress::hdr.ipv4.$valid
        # - bit[1..0]: egress::hdr.ipv4.ecn if egress::hdr.ipv4.$valid
    - W6: { pov: H4(3) }
        # - bit[31..16]: egress::hdr.ipv4.total_len if egress::hdr.ipv4.$valid
        # - bit[15..0]: egress::hdr.ipv4.identification if egress::hdr.ipv4.$valid
    - W13: { pov: H4(3) }
        # - bit[31..29]: egress::hdr.ipv4.flags if egress::hdr.ipv4.$valid
        # - bit[28..16]: egress::hdr.ipv4.frag_offset if egress::hdr.ipv4.$valid
        # - bit[15..8]: egress::hdr.ipv4.ttl if egress::hdr.ipv4.$valid
        # - bit[7..0]: egress::hdr.ipv4.protocol if egress::hdr.ipv4.$valid
    - W12: { pov: H4(3) }  # egress::hdr.ipv4.src_addr if egress::hdr.ipv4.$valid
    - MW4: { pov: H4(3) }  # egress::hdr.ipv4.dst_addr if egress::hdr.ipv4.$valid
  full_checksum 4: 
    - partial_checksum 4: { pov: H4(3) }
  partial_checksum 5: 
    - W5(16..31): { pov: H4(5) }  # bit[31..16]: egress::hdr.udp.dst_port if egress::hdr.udp.$valid
    - MH0: { pov: H4(5) }  # egress::meta.udp_tmp_checksum if egress::hdr.udp.$valid
  full_checksum 5: 
    - zeros_as_ones: true
    - partial_checksum 5: { pov: B17(1) }
    - clot 4: { pov: H4(5) }
  mirr_io_sel: { MH2(0..0): H4(0) }  # bit[0]: egress::eg_intr_md_for_dprsr.mirror_io_select if egress::eg_intr_md_for_dprsr.mirror_io_select.$valid
  egress_unicast_port: { MH1(0..8): H4(1) }  # bit[8..0]: egress::eg_intr_md.egress_port if egress::eg_intr_md.egress_port.$valid
stage 0 ingress:
  mpr_stage_id: 0
  mpr_bus_dep_glob_exec: 0x0
  mpr_bus_dep_long_brch: 0x0
  mpr_always_run: 0x3e
  phase0_match IngressParser.$PORT_METADATA:
    p4:
      name: IngressParser.$PORT_METADATA
      size: 288
      preferred_match_type: exact
      match_type: exact
    size: 288
    p4_param_order:
      ig_intr_md.ingress_port: { type: exact, size: 9 }
    format: {ig_intr_md: 0..127}
    constant_value: 0
    actions:
      set_port_metadata:
      - handle: 0x20000000
      - p4_param_order: { ig_intr_md: 128 } 
  exact_match arp_table_0 1:
    always_run: true
    p4: { name: Ingress.arp_table, size: 32 }
    p4_param_order: 
      hdr.arp.dstIpv4Addr: { type: exact, size: 32, full_size: 32 }
    row: 7
    bus: 0
    column: [ 2, 3, 4, 5 ]
    ways:
      - [1, 0, 0x0, [7, 2]]
      - [1, 1, 0x0, [7, 3]]
      - [1, 2, 0x0, [7, 4]]
      - [1, 3, 0x0, [7, 5]]
    input_xbar:
      exact group 0: { 64: hdr.arp.dstIpv4Addr }
      hash 1:
        0..7: random(hdr.arp.dstIpv4Addr(10..31)) ^ hdr.arp.dstIpv4Addr(0..7)
        8..9: random(hdr.arp.dstIpv4Addr(10..31)) ^ hdr.arp.dstIpv4Addr(8..9)
        11..18: random(hdr.arp.dstIpv4Addr(10..31)) ^ hdr.arp.dstIpv4Addr(0..7)
        19: random(hdr.arp.dstIpv4Addr(10..31)) ^ hdr.arp.dstIpv4Addr(8)
        10: random(hdr.arp.dstIpv4Addr(10..31)) ^ hdr.arp.dstIpv4Addr(9)
        22..29: random(hdr.arp.dstIpv4Addr(10..31)) ^ hdr.arp.dstIpv4Addr(0..7)
        20..21: random(hdr.arp.dstIpv4Addr(10..31)) ^ hdr.arp.dstIpv4Addr(8..9)
