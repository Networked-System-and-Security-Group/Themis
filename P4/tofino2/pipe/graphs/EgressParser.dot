digraph EgressParser{
start [shape=rectangle,label="start
(tmp)"]
parse_bridged_md [shape=rectangle,label="parse_bridged_md"]
parse_mirror_md [shape=rectangle,label="parse_mirror_md"]
parse_ethernet [shape=rectangle,label="parse_ethernet
(hdr.ethernet.ether_type)"]
parse_arp [shape=rectangle,label="parse_arp"]
parse_ipv4 [shape=rectangle,label="parse_ipv4
(hdr.ipv4.protocol)"]
parse_tcp [shape=rectangle,label="parse_tcp"]
parse_udp [shape=rectangle,label="parse_udp
(hdr.udp.dst_port)"]
parse_bth [shape=rectangle,label="parse_bth"]
accept [shape=rectangle,label="accept"]
reject [shape=rectangle,label="reject"]
start -> parse_mirror_md [label="8w9"]
start -> parse_bridged_md [label="8w6"]
start -> accept [label="default"]
parse_bridged_md -> parse_ethernet [label="always"]
parse_mirror_md -> parse_ethernet [label="always"]
parse_ethernet -> parse_ipv4 [label="16w0x800"]
parse_ethernet -> parse_arp [label="16w0x806"]
parse_ethernet -> accept [label="default"]
parse_arp -> accept [label="always"]
parse_ipv4 -> parse_tcp [label="8w6"]
parse_ipv4 -> parse_udp [label="8w17"]
parse_ipv4 -> accept [label="default"]
parse_tcp -> accept [label="always"]
parse_udp -> parse_bth [label="16w4791"]
parse_udp -> accept [label="default"]
parse_bth -> accept [label="always"]
}
